<%- include('partials/header.ejs') %>
<div class="pageContent">
<div class="btn delete-btn hidden-popup">
  <h1> Do you want to confirm the delete operation</h1>
  <h1 id="confirm-delete-id"> </h1>
      <button type='button' id="confirm-yes-btn">Delete</button>
      <button type='button' id="confirm-no-btn"> Cancel </button>
</div>
<div class="allNote">
            <ul>


 <% allBookNotes.forEach( (note) => { %>
    <div class="fullCard">
            <div class="imageSection">
                <img src=<%=note.book_cover_link%>>
                <p><%=note.book_cover_link%></p>
            </div>
            <div class="noteCard">
                <article class="eachNote">

                <!-- <h2> Image Section: <%= note.book_cover_link%></h2>    -->
                <h2 class="title">Title:<%= note.title %></h2>
                <div class="ratinganddate">
                <h2 class="rating">Rating:<%=note.rating%></h2>
                <h2 class="date">Date: <%=Intl.DateTimeFormat('en-US',{dateStyle:'full'}).format(note.date_read)%></h2>
                </div>
                <div class="reviewsection">
                <h2 class="reviewtitle">Review:</h2>
                <p class="reviewRecord"><%= note.notes %></p>
                </div>
                <form action=<%=note.id+"/edit" %>>
                    <button type="submit">edit</button>
                </form>
                <form action=<%=note.id+"/view" %>>
                    <button type="submit">view</button>
                </form>
                <form method="POST" action="/books/<%=note.id%>/delete">
                    <button type="submit" name="id" class="deleteButton" value="<%=note.id%>" data-title="<%=note.title%>">Delete</button>
                </form>

                </article>
            </div>

    </div>

                <% }); %>



            </ul>
</div>
<script>     
    //console.log('Delete Button Pressed')
    const deletePressed = document.querySelectorAll('.deleteButton');
    const confirmBox = document.querySelector('.btn.delete-btn');
    const deletePostId = document.querySelector('#confirm-delete-id');
    const confirmYesBtn = document.querySelector('#confirm-yes-btn');
    const confirmNoBtn = document.querySelector('#confirm-no-btn');
    let formToSubmit = null;
    deletePressed.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        const bookTitle = button.dataset.title;
        deletePostId.textContent = bookTitle;
        formToSubmit = button.closest('form'); //save the id of the record we pressed delete for

        confirmBox.classList.toggle('hidden-popup');

              })
      
      }

    );

  confirmYesBtn.addEventListener('click',() => {
          if (formToSubmit) {
            formToSubmit.submit(); //submit form if it is saved
            confirmBox.classList.toggle('hidden-popup')
          }
          })


  confirmNoBtn.addEventListener('click', () => {
      formToSubmit = null;
      confirmBox.classList.toggle('hidden-popup');
      })
    </script>
</div>
        </div>
    </body>
</html>
</div>
        </div>
    </body>
</html>
