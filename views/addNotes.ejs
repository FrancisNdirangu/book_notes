<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Document</title>
        <link rel="stylesheet" href="styles.css" />
    </head>
    <body>
        <div class="container">
            <div class="navbar">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="index">Add Book Notes</a></li>
                    <li><a href="view">View Book Notes</a></li>
                </ul>
            </div>
            <form action="/addBookNotes" method="post">

              <% if (locals.fieldErrors && Object.keys(fieldErrors).length > 0) { %>

              <div class="validation-errors">

                <h2> The following are errors in the AddBook form entry </h2>

                <ol>
                  <% Object.entries( fieldErrors ).forEach( (value,key) => { %>
                  <li><strong> <%= key %> </strong>: <%= value %> </li>
                  <% }) %>
                </ol>

              <% } %>


                <div class="input-section">
                    <h1 class="page-title">Add Book Notes</h1>
                    <div class="row-inputs">
                        <label for="title">Book Title</label>
                        <input type="text" name="title" value="<%= locals.formData?.title || '' %>" />

                        <label for="rating">Rating</label>
                        <input type="number" name="rating" value="<%= locals.formData?.rating || '' %>"/>

                        <label for="dateRead">Date Read</label>
                        <input
                            type="text"
                            name="dateRead"
                            placeholder="yyyy-mm-dd"
                            value="<%= locals.formData?.dateRead || '' %>"
                        />
                    </div>
                    <div class="review-section">
                        <label for="review">Review</label>
                        <textarea type="text" name="review"> <%= locals.formData?.notes %> </textarea>
                    </div>
                    <button type="submit">Submit 2</button>
                </div>
            </form>
        </div>
    </body>
</html>
