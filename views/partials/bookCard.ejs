            <div class="imageSection">
                <img alt="<%=note.title%>" src="<%=note.olid ? note.book_cover_link : "notFoundImage/notFoundBookCover.png"%>">
                <p><%=note.book_cover_link ? note.book_cover_link : "the book cover does not exist in the api"%></p>
            </div>
            
            <div class="noteCard">
                <article class="eachNote">

                <!-- <h2> Image Section: <%= note.book_cover_link%></h2>    -->
                <h2 class="title">Title:<%= note.title %></h2>
                <div class="ratinganddate">
                    <h2 class="rating">Rating:<%=note.rating%></h2>
                    <h2 class="date">Date: <%=Intl.DateTimeFormat('en-US',{dateStyle:'full'}).format(note.date_read)%></h2>
                </div>
                <div class="reviewsection">
                    <h2 class="reviewtitle">Review:</h2>
                    <p class="reviewRecord"><%= note.notes %></p>
                </div>

            <div class="buttons">
                    <form action=<%=note.id+"/edit" %>>
                        <button type="submit">edit</button>
                    </form>
                    <form action=<%=note.id+"/view" %>>
                        <button type="submit">view</button>
                    </form>
                    <form method="POST" action="/books/<%=note.id%>/delete">
                        <button type="submit" name="id" class="deleteButton" value="<%=note.id%>" data-title="<%=note.title%>">Delete</button>
                    </form>


                </div>

                </article>
            </div>