<%- include('partials/header.ejs') %>
<div class="editing-field"> 

            <h1 class="page-title">Edit Book Notes: <%=blog.title%></h1>
            <form action="/books/<%=blog.id%>/edit" method="POST"> 
            <label for="title">Title</label>
            <input name="title" type="text" value="<%=blog.title%>"/>

            <label for="newRating">Rating</label>
            <input name="newRating" type="number" value="<%=blog.rating%>"/>

            <label for="date">Date</label>
            <input name="date" type="date" value="<%=blog.date_read%>"/>

            <label for="editedNotes">Review</label>
            <textarea name="editedNotes" type="text" rows="10" cols="60"><%=blog.notes%> </textarea>

            <button type="submit">Submit</button>




            </form>
</div>
        </div>
    </body>
</html>
