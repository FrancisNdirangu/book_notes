<%- include('partials/header.ejs') %>
<%- include('partials/navbar.ejs') %>
<% if (locals.fieldErrors && Object.keys(fieldErrors).length > 0) { %>

<%- include('partials/validationPartial.ejs',{fieldErrors}) %>
<% } %>

<main>
<div class="editing-field"> 

            <h1 class="page-title">Edit Book Notes: <%=blog.title%></h1>
            <form action="/books/<%=blog.id%>/edit" method="POST"> 
            <label for="title">Title</label>
            <input name="title" type="text" value="<%=blog.title%>"/>

            <label for="rating">Rating</label>
            <input name="rating" type="number" value="<%=blog.rating%>"/>

            <label for="date">Date</label>
            <input name="date" type="text" value="<%=blog.date%>"/>

            <label for="notes">Review</label>
            <textarea name="notes" type="text" rows="10" cols="60"><%=blog.notes%> </textarea>

            <button type="submit">Submit</button>




            </form>
</div>
</main>
        </div>
    </body>
</html>
