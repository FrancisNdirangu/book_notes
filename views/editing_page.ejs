<%- include('partials/header.ejs') %>
<div class="editing-field"> 

            <h1 class="page-title">Edit Book Notes: <%=blog.title%></h1>
            <form> 
            <label for="title">Title</label>
            <input name="title" type="text" value="<%=blog.title%>"/>

            <label for="rating">Rating</label>
            <input name="rating" type="number" value="<%=blog.rating%>"/>

            <label for="date">Date</label>
            <input name="date" type="date" value="<%=blog.date_read%>"/>

            <label for="review">Review</label>
            <input name="review" type="text" value="<%=blog.notes%>"/>




            </form>
</div>
        </div>
    </body>
</html>
